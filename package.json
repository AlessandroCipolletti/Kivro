{
  "name": "kivro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.13.0", "pnpm": ">=10" },
  "scripts": {
    "dev:setup": "node --import tsx scripts/dev-setup.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "dev:demo": "node --import tsx scripts/dev-setup.ts --demo",
    "dev:stop": "docker compose -f infrastructure/compose.yaml stop",
    "dev:reset": "node --import tsx scripts/dev-reset.ts",
    "dev:health": "node --import tsx scripts/health.ts",
    "worker:dev": "node --env-file=.env --import tsx apps/worker/src/index.ts start",
    "worker": "node --env-file=.env --import tsx apps/worker/src/index.ts",
    "worker:package": "node --import tsx scripts/package-worker.ts",
    "cloud:package": "node --import tsx scripts/package-cloud.ts",
    "test:cloud-artifacts": "node --import tsx scripts/verify-cloud-artifacts.ts",
    "db:generate": "pnpm --filter @kivro/database generate",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:seed": "node --import tsx scripts/database.ts seed",
    "db:studio": "node --import tsx scripts/database.ts studio",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint apps packages scripts tests --no-warn-ignored",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:setup": "node --import tsx scripts/integration-setup.ts",
    "test:integration": "KIVRO_INTEGRATION=1 vitest run tests/integration apps/api/test packages/resource-broker/test/postgres.integration.test.ts",
    "test:sandbox": "node --env-file=.env --import tsx security/sandbox/smoke.ts",
    "dev:sandbox": "docker build -t kivro-sandbox:2026.8.2 security/sandbox",
    "test:e2e:local": "node --env-file=.env --import tsx scripts/e2e-local.ts",
    "test:e2e:fixture": "node --import tsx scripts/e2e-fixture.ts --run",
    "test:e2e:browser-runtime": "node --import tsx scripts/e2e-fixture.ts --run --browser",
    "test:e2e:faults": "node --import tsx scripts/e2e-fixture.ts --run --faults",
    "test:e2e:media": "node --import tsx scripts/e2e-media-fixture.ts --run",
    "test:e2e:orchestration": "node --import tsx scripts/e2e-orchestration-fixture.ts --run",
    "test:fresh-clone": "node --import tsx scripts/fresh-clone-check.ts --run",
    "test:fresh-clone:runtime": "node --import tsx scripts/fresh-clone-check.ts --run --with-runtime",
    "test:e2e:web": "playwright test",
    "test:e2e:web:flows": "playwright test --config apps/web/playwright.config.ts",
    "build": "pnpm --filter @kivro/web build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "coverage:audit": "node --import tsx scripts/coverage-audit.ts",
    "coverage:merge": "node --import tsx scripts/coverage-merge.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "better-sqlite3"]
  }
}
