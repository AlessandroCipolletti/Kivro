NODE_ENV=development
KIVRO_ENV=development
DEV_AUTH_ENABLED=true
# Local deterministic credits. Switch to stripe only with dedicated Stripe test keys.
PAYMENT_MODE=fake
DATABASE_URL=postgresql://kivro:kivro_local_only@127.0.0.1:55432/kivro?schema=public
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=kivro_local
S3_SECRET_KEY=kivro_local_storage_only
S3_BUCKET=kivro-development
S3_FORCE_PATH_STYLE=true
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_FROM=accounts@kivro.local
SMTP_REQUIRE_TLS=false
# Production requires an operator-reviewed UTF-8 terms file and immutable version.
# MARKETPLACE_TERMS_FILE=/absolute/path/to/marketplace-terms.txt
# MARKETPLACE_TERMS_VERSION=2026-10-06
# Production: verified TLS, a dedicated SMTP sender, and credentials via secrets.
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
NEXT_PUBLIC_API_URL=/api
SESSION_SECRET=replace-with-generated-local-secret
KIVRO_WORKER_HOME=.kivro/worker
KIVRO_SANDBOX_IMAGE=kivro-sandbox:2026.8.2
OPENCLAW_BIN=openclaw
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_INFERENCE_PROVIDER=
PLATFORM_INFERENCE_MODEL=
# Development/test only: logs request shape and identifiers, never raw content.
PLATFORM_INFERENCE_DEBUG=false
# Set one dedicated key. With both keys, choose the provider explicitly above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional dedicated platform aliases take precedence over the standard names.
PLATFORM_OPENAI_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_INFERENCE_INPUT_MICRO_USD_PER_MILLION=
PLATFORM_INFERENCE_OUTPUT_MICRO_USD_PER_MILLION=
# Storage and execution ceilings. Apply the job limits to both API and Worker.
# Deployment settings may lower, never exceed, the reviewed implementation bounds.
MAX_UPLOAD_BYTES=26214400
KIVRO_MAX_JOB_FILE_BYTES=8388608
KIVRO_MAX_JOB_INPUT_BYTES=16777216
KIVRO_MAX_JOB_OUTPUT_BYTES=16777216
ASSET_RETENTION_DAYS=7
JOB_CONTENT_RETENTION_DAYS=30
OPERATIONAL_AUDIT_RETENTION_DAYS=90
# Cumulative confirmed pause allowance per job (1000..900000 ms), snapshotted on purchase.
KIVRO_MAX_JOB_PAUSE_MS=900000
ACCOUNT_REQUESTS_PER_MINUTE=180
ACCOUNT_WRITES_PER_MINUTE=60
ACCOUNT_JOBS_PER_DAY=100
ACCOUNT_JOB_SPEND_MINOR_PER_DAY=100000
AGENT_TURNS_PER_DAY=100
